# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data ---
# The raw UCI dataset is small (~80KB) and public, so it's committed
# directly - that's what lets CI train the model from scratch on every run.
# Processed files are regenerated by src/data_processing.py, so they stay
# out of git.
data/processed/*
!data/processed/.gitkeep

# --- Trained models (binaries don't belong in git history) ---
models/*.pkl
!models/.gitkeep

# --- Environment / secrets ---
.env

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
